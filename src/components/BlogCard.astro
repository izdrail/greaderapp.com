---
const { title, image, url, date, author, comments } = Astro.props;
---
<div class="single-blog-post">
    <!-- Post Thumb -->
    <div class="post-thumb">
        <a href={url}><img src={image} alt="Blog Post" /></a>
    </div>
    <!-- Post Content -->
    <div class="post-content">
        <div class="post-meta mb-2">
            <a href="#" class="post-date"><i class="fas fa-calendar-alt mr-2"></i>{date}</a>
            <a href="#" class="post-author"><i class="fas fa-user mr-2"></i>{author}</a>
            <a href="#" class="post-comments"><i class="fas fa-comments mr-2"></i>{comments} Comments</a>
        </div>
        <a href={url} class="post-title">
            <h4>{title}</h4>
        </a>
        <p>Stay up to date with the latest features of gReader News.</p>
        <a href={url} class="btn btn-bordered mt-4">Read More</a>
    </div>
</div>
