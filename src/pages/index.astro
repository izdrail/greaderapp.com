---
import MarketingLayout from "../layouts/MarketingLayout.astro";
const features = [
  ["Offline reading", "Cache article content and keep reading when the connection disappears.", "↓"],
  ["Fast feed browsing", "Scan more headlines in list, grid or card layouts without an algorithm rearranging them.", "≡"],
  ["Folders and feed control", "Organise subscriptions, tune per-feed behaviour and keep large reading lists manageable.", "⌑"],
  ["Reading mode", "Extract the article, adjust text and images, invert the page and focus on the words.", "Aa"],
  ["Search and states", "Search articles and move quickly between all, unread and starred views.", "⌕"],
  ["Podcasts and TTS", "Play feed audio or listen to articles with configurable voice, speed and pitch.", "▶"],
  ["OPML import and export", "Bring your subscriptions with you and take them back out whenever you want.", "⇄"],
  ["Themes and layouts", "Choose the density, colour theme and article-list shape that suit the way you read.", "◐"],
];
const faqs = [
  ["Is this the original gReader?", "No. This is an independent open-source project inspired by the classic gReader workflow. It is not affiliated with or endorsed by the original developer."],
  ["Is it really free?", "Yes. There is no paid tier and no recurring subscription; the free app is supported by ads."],
  ["Can I import my feeds?", "Yes. OPML import is built in, alongside direct feed URLs and feed discovery."],
  ["Does it work offline?", "The app has local storage, caching and offline preferences so saved content remains available without a connection."],
  ["What about the home-screen widget?", "A native Android widget is in development. It is not being presented as a finished feature until it has been verified on device."],
  ["Where is the source?", "The app is developed in public on GitHub. You can inspect the code, report an issue or contribute."],
];
---
<MarketingLayout title="gReader App - RSS reading, without the noise">
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Independent and open source</p>
        <h1>Remember when RSS readers were actually <em>RSS readers?</em></h1>
        <p class="lede">A fast, focused reader inspired by the classic gReader experience. No subscription. No algorithm deciding what you should read.</p>
        <div class="hero-actions">
          <a class="button" href="https://app.greaderapp.com">Open the web app <span aria-hidden="true">→</span></a>
          <a class="text-link" href="https://github.com/laravelcompany/app.greaderapp.com">View source on GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <ul class="proof-row" aria-label="Product principles">
          <li>Free forever</li><li>Local RSS</li><li>OPML import</li>
        </ul>
      </div>
      <div class="hero-visual" aria-label="The gReader article list interface">
        <div class="signal-card signal-one"><b>All your feeds</b><span>One calm reading list</span></div>
        <div class="phone-frame"><img src="/assets/img/app/feeds.png" alt="gReader App article list with all, unread and starred filters" width="430" height="900" /></div>
        <div class="signal-card signal-two"><b>No ranking</b><span>You choose what matters</span></div>
      </div>
    </div>
  </section>

  <section class="principles" aria-label="Product qualities">
    <div class="shell principles-grid"><span>Fast</span><i></i><span>Offline</span><i></i><span>Customisable</span><i></i><span>Open source</span></div>
  </section>

  <section id="why" class="section story-section">
    <div class="shell story-grid">
      <div><p class="kicker">Why this exists</p><h2>People didn't stop wanting the workflow. They lost the software that delivered it.</h2></div>
      <div class="story-copy">
        <p>For years, gReader earned a loyal following by treating RSS as a reading tool, not a social feed. It was fast, dense, configurable and useful offline.</p>
        <p>Then updates slowed, integrations broke and the app disappeared from the store. People kept asking for something that worked the same way.</p>
        <p><strong>We kept the parts worth keeping and rebuilt them in the open.</strong></p>
        <a class="arrow-link" href="/story.html">Read the project story <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="section control-section">
    <div class="shell control-grid">
      <div class="control-copy"><p class="kicker">Your feeds. Your rules.</p><h2>Built around the way people actually read.</h2><p>Follow the sites you care about. Organise them into folders. Scan headlines quickly. Mark items as you go. Save what matters. Read or listen when it suits you.</p><ul class="check-list"><li>No “For You” feed</li><li>No oversized cards forced on you</li><li>No account required for local RSS</li></ul></div>
      <div class="screen-stage"><div class="phone-frame phone-secondary"><img src="/assets/img/app/subscribe.png" alt="Add a feed by URL, browse, news, podcasts or OPML" width="430" height="900" /></div><div class="stage-note"><span>01</span><b>Add feeds your way</b><small>URL, discovery, podcast or OPML</small></div></div>
    </div>
  </section>

  <section id="features" class="section features-section">
    <div class="shell"><div class="section-heading"><p class="kicker">What is here today</p><h2>A serious reading toolkit, without a premium gate.</h2><p>These are working parts of the current app, not a nostalgic wish list.</p></div><div class="feature-grid">{features.map(([title, copy, icon]) => <article class="feature-card"><span class="feature-icon">{icon}</span><h3>{title}</h3><p>{copy}</p></article>)}</div></div>
  </section>

  <section class="section pledge-section">
    <div class="shell pledge-grid"><div><p class="kicker kicker-light">The ownership promise</p><h2>Built so it cannot simply disappear.</h2></div><div><p>Great software can vanish while people still depend on it. Open source changes that. The code is public, the app is free and there is no closed service required for local feeds.</p><div class="pledges"><span>No premium tier</span><span>No subscription</span></div><a class="button button-light" href="https://github.com/laravelcompany/app.greaderapp.com">Explore the source <span>↗</span></a></div></div>
  </section>

  <section id="screens" class="section screens-section">
    <div class="shell"><div class="section-heading"><p class="kicker">The app, not a mockup</p><h2>Fast. Dense. Familiar.</h2><p>Current screens captured from the running app, with real feeds loaded.</p></div><div class="screen-grid"><figure><div class="phone-frame"><img src="/assets/img/app/feeds.png" alt="Article list with unread counts, search and all, unread and starred filters" width="430" height="900" /></div><figcaption><b>Reading list</b><span>Search, all, unread and starred</span></figcaption></figure><figure><div class="phone-frame"><img src="/assets/img/app/reader.png" alt="Article reader with feed, reading and web views plus text controls" width="430" height="900" /></div><figcaption><b>Article reader</b><span>Feed, reading and web views</span></figcaption></figure><figure><div class="phone-frame"><img src="/assets/img/app/menu.png" alt="Side menu with feeds, unread counts and offline tools" width="430" height="900" /></div><figcaption><b>Your feeds</b><span>Unread counts per feed</span></figcaption></figure><figure><div class="phone-frame"><img src="/assets/img/app/subscriptions.png" alt="Manage subscriptions with folders and unread counts" width="430" height="900" /></div><figcaption><b>Manage feeds</b><span>Folders and per-feed control</span></figcaption></figure><figure><div class="phone-frame"><img src="/assets/img/app/tts.png" alt="Voice reading queue with voice, speed and pitch controls" width="430" height="900" /></div><figcaption><b>Listen</b><span>Voice, speed and pitch controls</span></figcaption></figure><figure><div class="phone-frame"><img src="/assets/img/app/dark.png" alt="Article list in the dark reading theme" width="430" height="900" /></div><figcaption><b>Dark theme</b><span>Default, green, sepia, dark and black</span></figcaption></figure></div><div class="wide-grid"><figure><img src="/assets/img/app/tablet-feeds.png" alt="Article list on a 7-inch tablet in portrait" width="1200" height="1920" /><figcaption><b>Tablets</b><span>The same reading list, scaled up</span></figcaption></figure><figure><img src="/assets/img/app/desktop-dark.png" alt="Desktop layout with sidebar and article list in the dark theme" width="1920" height="1080" /><figcaption><b>Chromebooks and desktop</b><span>Sidebar layout, dark theme</span></figcaption></figure></div></div>
  </section>

  <section class="section migration-section"><div class="shell migration-grid"><div><p class="kicker">Bring your reading list</p><h2>Already using another reader?</h2></div><div><p>Export your subscriptions as OPML, import the file and keep your feed list under your control. You can export it again at any time.</p><a class="button" href="https://app.greaderapp.com/subscribe">Import your feeds <span>→</span></a></div></div></section>

  <section class="section faq-section"><div class="shell"><div class="section-heading"><p class="kicker">Questions</p><h2>The straight answers.</h2></div><div class="faq-grid">{faqs.map(([question, answer]) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></div></section>

  <section class="final-cta"><div class="shell final-inner"><p class="kicker kicker-light">Take back your reading list</p><h2>Your feeds. Your device. Your rules.</h2><p>Read the open web without turning it into another social timeline.</p><div><a class="button button-light" href="https://app.greaderapp.com">Open the app →</a><a class="text-link text-link-light" href="https://github.com/laravelcompany/app.greaderapp.com">View on GitHub ↗</a></div></div></section>
</MarketingLayout>
