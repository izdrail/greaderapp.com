								<a class="card-thumb" href="blog-single-right-sidebar.html">
									<img src="/assets/img/blog/blog-1.jpg" alt="">
								</a>
								<div class="card-overlay top fade-down">
									<div class="logo">
										<img src="/assets/img/content/author.png" alt="">
