						</div>
					</div>
				</div>

				<div class="row justify-content-center">
					<div class="col-12 col-md-10">
						<!-- gReader App Accordion -->
						<div class="accordion accordion-flush" id="sapp-accordion">
							<!-- Accordion Item -->
							<div class="accordion-item outlined">
								<h4 class="accordion-header">
									<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
									How to install gReader App?
									</button>
								</h4>
								<div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#sapp-accordion">
									<div class="accordion-body">To install gReader App, follow the <a href="#">step-by-step instructions</a> in the provided documentation. It covers everything you need to set up and customize the theme effortlessly.</div>
								</div>
							</div>

							<!-- Accordion Item -->
